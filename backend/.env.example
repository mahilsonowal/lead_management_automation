# Server Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=info

# API Settings
API_TITLE="AI-Powered Lead Management & Analysis Service"
API_VERSION="1.1.0"

# AI Provider Configuration
# Supported options: "none" (deterministic rules), "gemini", "openai", "ollama"
AI_PROVIDER="none"

# Google Gemini API Settings
GEMINI_API_KEY="your_gemini_api_key_here"
GEMINI_MODEL="gemini-1.5-flash"

# OpenAI API Settings
OPENAI_API_KEY="your_openai_api_key_here"
OPENAI_MODEL="gpt-4o-mini"

# Ollama Local Model Settings
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3.2"

# Reliability & Fallback Settings
AI_TIMEOUT_SECONDS=8.0
AI_MAX_RETRIES=2
AI_RETRY_DELAY_SECONDS=1.0
